# Copy to .env and fill in. .env is gitignored. Never commit real keys or secrets.
NUXT_MEMTIME_API_KEY=
NUXT_MEMTIME_BASE_URL=https://interview-api.memtime-demo.deno.net/api/v1

# OAuth 2.0 login with Memtime. Login is on only when NUXT_CLIENT_ID is set; leave it empty to run
# on the API key alone (mock API, npm run smoke).
NUXT_CLIENT_ID=
NUXT_CLIENT_SECRET=
NUXT_REDIRECT_URI=http://localhost:3000/authentication/callback
NUXT_AUTH_BASE_URL=https://interview-api.memtime-demo.deno.net/auth
NUXT_AUTH_SCOPE=time_tracking
# 32+ random characters, for encrypting tokens at rest: openssl rand -base64 32
NUXT_SESSION_SECRET=
